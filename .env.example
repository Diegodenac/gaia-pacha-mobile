# ───────────────────────────────────────────────────────────────────────────────
# Environment Configuration Template
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env.local to Git.

# ─── Mobile App API ───────────────────────────────────────────────────────────
# The base URL for your backend API (where this mobile app makes requests)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ─── Database Configuration (For Backend Service) ───────────────────────────────
# These credentials are used by the backend API server to connect to PostgreSQL
# DO NOT use these directly in the mobile app

# Aiven PostgreSQL Database Details
DATABASE_HOST=your-host.aivencloud.com
DATABASE_PORT=16933
DATABASE_NAME=defaultdb
DATABASE_USER=avnadmin
DATABASE_PASSWORD=your_password_here

# Alternative: Full PostgreSQL Connection String (if your backend supports it)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ─── Database Connection Options ──────────────────────────────────────────────
DATABASE_SSL_MODE=require
DATABASE_CONNECTION_LIMIT=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=15000

# ─── Build Profiles ───────────────────────────────────────────────────────────
APP_ENV=development
EAS_BUILD_PROFILE=development

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_DEBUG_MENU=true
ENABLE_MOCK_DATA=false
